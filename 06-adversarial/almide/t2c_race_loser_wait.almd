// 意地悪2c: race の勝者確定後、main が 3 秒生き延びたら敗者は蘇るのか。
// 蘇ったら、敗者は「キャンセル」ではなく「放置」= 野良タスク。
//
// fan.race は fan.min(clock) に改名された (epoch 14, ADR-0028)。実時間の先着
// (fan.min(duration.ms(n)) { … }) は #3788 で入る予定で、今は型エラー。compute 時計の
// fan.min は腕を source 順に予算つきで走らせ、腕は pure (sleep も println もできない)。
// 敗者は予算超過で打ち切られるので、勝者確定後に蘇る余地がない — それを 3 秒待って確かめる。
import env

fn heavy(n: Int) -> Int = {
  var i = 0
  var acc = 0
  while i < n {
    acc = (acc + i * 7) % 999983
    i = i + 1
  }
  acc
}

fn fast() -> String = if heavy(10000) >= 0 then "fast won" else "unreachable"

// 予算 (compute.ms(5)) を大きく超える敗者
fn slow_noisy() -> String = if heavy(100000000) >= 0 then "slow" else "unreachable"

effect fn main() -> Unit = {
  let winner = fan.min(compute.ms(5)) {
    fast()
    slow_noisy()
  }
  match winner {
    ok(w) => println("winner: ${w}"),
    err(e) => println("race err: ${e}"),
  }
  println("main stays alive 3s...")
  env.sleep_ms(3000)
  println("main exiting")
}
